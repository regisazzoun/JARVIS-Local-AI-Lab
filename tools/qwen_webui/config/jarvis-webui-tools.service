[Unit]
Description=Open WebUI thin JARVIS and Qwen Code adapter
After=jarvis-conversation.service jarvis-qwen-guard.service
[Service]
User=adminjarvis
WorkingDirectory=/home/adminjarvis/JARVIS/qwen-code-projects
ExecStart=/opt/jarvis/conversation/.venv/bin/python /opt/jarvis/webui-tools/webui_adapter.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
