[Unit]
Description=Bounded Codex escalation support for the existing M26-P2 mission
After=network-online.target jarvis-mission-worker.service
[Service]
Type=oneshot
User=adminjarvis
Group=adminjarvis
WorkingDirectory=/home/adminjarvis/JARVIS/mission26-phase2
Environment=PATH=/home/adminjarvis/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=JARVIS_COORDINATOR_CONFIG=/home/adminjarvis/JARVIS/mission26-phase2-private/supervision/config.json
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/jarvis-coordination/periodic_codex.py
TimeoutStartSec=450
KillMode=control-group
