@@ -30,4 +30,21 @@ class GuardChecks(unittest.TestCase):
  def test_no_secret_in_nested_events(self):
   x=redact({'token':'secret','result':{'api_secret':'secret','stdout':'Authorization Bearer abc.def.ghi'}})
   self.assertNotIn('abc.def.ghi',json.dumps(x));self.assertNotIn('"secret"',json.dumps(x))
+ def test_failed_completed_test_is_control_without_erasing_failures(self):
+  a=Attempts()
+  write=lambda i:{'id':str(i),'tool':'host_write_file','arguments':{'path':'x.js'},'result':{'ok':True}}
+  a.observe(write(1));a.observe(write(2))
+  test={'id':'test','tool':'host_exec','arguments':{'command':'node --test x.test.mjs'},'result':{'ok':False,'result':{'returncode':1,'stdout':'# tests 6\n# fail 1\n'}}}
+  self.assertIsNone(a.observe(test));self.assertIsNone(a.observe(write(3)))
+  self.assertEqual(sum(map(len,a.failures.values())),1)
+ def test_pipeline_success_does_not_hide_tap_failure(self):
+  a=Attempts()
+  for i in range(3):
+   r=a.observe({'id':str(i),'tool':'host_exec','arguments':{'command':'node --test x.test.mjs | cat'},'result':{'ok':True,'result':{'returncode':0,'stdout':'# tests 6\n# fail 1\n'}}})
+  self.assertEqual(r['kind'],'three_failures')
+ def test_mjs_files_are_distinct_but_aliases_still_match(self):
+  from loop_guard import blocker
+  def key(command):return blocker({'tool':'host_exec','arguments':{'command':command},'result':{'ok':False}})
+  self.assertNotEqual(key('node a.test.mjs'),key('node b.test.mjs'))
+  self.assertEqual(key('node a.test.mjs'),key('node ./a.test.mjs'))
 if __name__=='__main__':unittest.main()
