   if failed:
    key=blocker(call);self.failures[key].append(call['id'])
    if len(self.failures[key])>=3:return {'kind':'three_failures','blocker':key,'attempts':self.failures[key], 'status':'BLOQUÉE — ANALYSE DOCUMENTÉE','next':'Arrêter cette stratégie ; diagnostiquer et planifier une approche réellement différente. Les tâches indépendantes peuvent continuer.'}
   if call.get('tool') in ('host_read_file','host_policy','capability_status','mission_progress','mission_evidence') and result.get('ok'):
    sig=hashlib.sha256(json.dumps([call['tool'],call.get('arguments'),nested.get('stdout',nested.get('content',''))],sort_keys=True).encode()).hexdigest();self.reads[sig].append(call['id'])
    if len(self.reads[sig])>=3:return {'kind':'repeated_unchanged_reads','blocker':'stagnation:'+call['tool'],'attempts':self.reads[sig],'status':'BLOQUÉE — ANALYSE DOCUMENTÉE','next':'Les observations sont acquises ; changer de tâche ou agir sur le diagnostic, sans relire une quatrième fois.'}
